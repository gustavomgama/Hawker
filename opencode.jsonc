{
  "$schema": "https://opencode.ai/config.json",
  // The global config sets compaction.auto=false; re-enable it for this project.
  // OpenCode 2.1.3 rejects buffer as a percentage and silently drops it, so the
  // token form is used: 1M window - 930k kept free = compaction at ~70k used.
  "compaction": {
    "auto": true,
    "reserved": 930000
  }
}
